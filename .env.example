# Copy to .env.local and fill in to enable real model answers.
# This app is pre-configured for xKiro (https://xkiro.com) — an OpenAI-compatible
# gateway with 40+ free models. Create an API key at:
#   https://xkiro.com/dashboard/api/keys
# Without a key the app runs in built-in offline demo mode.

XKIRO_API_KEY=sk-your-xkiro-key-here
XKIRO_BASE_URL=https://api.xkiro.com/v1

# Optional: the legacy OpenAI env names still work as fallbacks
# (cleared above wins). Base URL default is https://api.xkiro.com/v1.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------
# Real authentication (Firebase Auth — Google/GitHub sign-in).
#
# Optional: when these four are set, the app requires sign-in before
# chatting and stores each account's data separately. Until then the
# app runs anonymously (no login gate), exactly as before.
#
# 1. Create a project at https://console.firebase.google.com/
# 2. Add a Web app (</> ) to get the config values below.
# 3. Enable sign-in: Build → Authentication → Sign-in method →
#    enable Google and GitHub, then Save.
# 4. GitHub: in console Authentication → Sign-in method → GitHub →
#    create an OAuth app at https://github.com/settings/developers
#    using the Firebase-provided Authorization callback URL.
# ----------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=